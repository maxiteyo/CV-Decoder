# --- Contexto interno (no se sube a Git) ---
contexto.txt

# --- Datos crudos y procesados (no se versionan) ---
# Se conservan las carpetas vacías con .gitkeep para que el clon tenga la
# estructura que pide la plantilla. Los archivos reales quedan fuera de Git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Benchmarks completos: incluyen cientos de CVs reales (PDFs) y las planillas
# de calificación con texto de CVs. Se regeneran con los scripts de scripts/.
data/benchmarks/*
!data/benchmarks/.gitkeep

# --- Modelos entrenados y artefactos ---
models/*
!models/.gitkeep

# --- Entornos virtuales ---
.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Sistema / editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Claves y credenciales ---
.env
kaggle.json
